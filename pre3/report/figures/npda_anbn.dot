digraph NPDA {
  rankdir=LR;
  node [fontname="monospace"];
  labelloc="t"; label="NPDA: aⁿbⁿ (DCFL)";
  "q0" [shape=circle];
  "q1" [shape=circle];
  "q_acc" [shape=doublecircle];
  __start [shape=point, width=0.1];
  __start -> "q0";
  "q0" -> "q0" [label="a, Z/AZ", fontsize=9];
  "q0" -> "q0" [label="a, A/AA", fontsize=9];
  "q0" -> "q_acc" [label="ε, Z/Z", fontsize=9];
  "q0" -> "q1" [label="ε, A/A", fontsize=9];
  "q1" -> "q1" [label="b, A/ε", fontsize=9];
  "q1" -> "q_acc" [label="ε, Z/Z", fontsize=9];
}